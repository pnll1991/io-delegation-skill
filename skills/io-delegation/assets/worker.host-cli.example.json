{
  "approved": false,
  "adapter": "host-cli",
  "timeout_seconds": 120,
  "max_calls_per_workspace": 4,
  "context_auto_dispatch": false,
  "model_policy": {
    "preset": "balanced",
    "hosts": {
      "codex": {
        "max_profile": "astra-low",
        "allow_escalation": true,
        "max_escalations": 2,
        "blocked_profiles": []
      },
      "cursor": {
        "strategy": "direct",
        "max_profile": "sol-high",
        "allow_escalation": true,
        "max_escalations": 1,
        "blocked_profiles": []
      }
    }
  }
}
